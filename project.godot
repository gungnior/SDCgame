; Godot 4.7.2 工程配置
;
; 依据 specs/tech-stack.md：
;   T-02  渲染器 Compatibility（2D 纯像素游戏，兼容设备最广）
;   T-03  粒子必须用 CPUParticles2D —— GPUParticles2D 在 Compatibility 下【静默失效】
;   T-15  stretch: canvas_items + keep + integer（像素完美）
;   T-16  纹理过滤 = Nearest
;
; 决策 D-16：本项目【不申请 INTERNET 权限】，代码内零网络请求。

config_version=5

[application]

config/name="搜打撤"
config/description="2D 像素俯视搜打撤 · 单机 PvE · 完全离线"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://art/icon.png"
; 主场景 = 可玩的突袭场景（表现层最小闭环）
run/main_scene="res://view/raid_scene.tscn"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
; ⚠️ expand 而不是 keep。真机实测：keep 在 20:9 手机上左右各留 415px 黑边，
;    游戏只占屏宽 70%（2750x1260 屏，16:9 视口）。expand 让视口随屏扩展、
;    多看到的是地图而不是黑边 —— 俯视射击正需要更宽的视野。
window/stretch/aspect="expand"
window/stretch/scale_mode="integer"

[rendering]

; T-02：桌面用 Forward+ 开发，移动导出自动切 Compatibility
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="gl_compatibility"
; T-16：Nearest（0 = Nearest）
textures/canvas_textures/default_texture_filter=0
; ⚠️ 实测（M0）：导出 Android 会报错「需要 ETC2/ASTC 纹理压缩格式」，【必须开启】。
;    这不是"要不要压缩"的选择题 —— 它是 Android 导出的前置能力开关。
;    开启后仍可按纹理决定压缩方式：像素画素材建议在各自的 .import 里设为 Lossless，
;    避免有损压缩糊掉像素边缘（见 specs/tech-stack.md V-07）。
textures/vram_compression/import_etc2_astc=true

[physics]

; T-51：提高 physics ticks 换低延迟与低穿模，不用 physics interpolation
common/physics_ticks_per_second=120

[input_devices]

; 触摸屏控制；不申请网络权限
pointing/emulate_mouse_from_touch=true

[internationalization]

; ⚠️ M0 关键项(1/2)：中文断行必须靠 ICU 断行规则数据，而该数据【默认不导出】。
; 不开这一项，中文换行/分词会不正确。代价：包体约 +4 MB。
; 验证：test/run_tests.gd 的「CJK 字体与中文断行」套件。
locale/include_text_server_data=true
[autoload]

; 手感与音频总线（specs/tech-stack.md §7.3）
Sfx="*res://audio/sfx.gd"
Feel="*res://feel/feel.gd"
; 遥测：结构化日志 -> logcat -> 主机端 tools/monitor_game.py
Tel="*res://telemetry/telemetry.gd"
; 跨场景持久状态（藏身处 / 玩家设置）
Game="*res://game/game_state.gd"